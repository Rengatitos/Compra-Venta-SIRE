# Base de la API. Vacio o sin definir usa /api/v1, que en desarrollo pasa por el
# proxy de Vite hacia http://127.0.0.1:9007 (ver vite.config.ts).
# En produccion apunta al host real, por ejemplo https://api.midominio.pe/api/v1
VITE_API_BASE_URL=

# Client ID OAuth de Google, tipo "aplicacion web". No es un secreto: viaja en
# el bundle y lo que protege el acceso son los "Origenes de JavaScript
# autorizados" del cliente en Google Cloud (en desarrollo,
# http://localhost:5173). Sin el, /login no puede pintar el boton de Google.
VITE_GOOGLE_CLIENT_ID=
