# URL del backend SIRE, incluido el prefijo de la API versionada.
API_BASE_URL=http://127.0.0.1:9007/api/v1

# Credenciales de Twilio. Completar solo en .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# En Sandbox: +14155238886 (el número de destino mostrado por Twilio).
# El número del cliente se autoriza en React; no se configura como emisor aquí.
TWILIO_VALIDATE_SIGNATURE=true
# URL publica del webhook, sin espacios al final.
TWILIO_WEBHOOK_URL=https://tu-dominio/webhooks/twilio/whatsapp
# Opcionales: plantillas Twilio Content con variable {{1}} para el resumen
# y payloads CONFIRMAR/CORREGIR/CANCELAR o CONFIRMAR VALIDOS.
# Sin plantillas se usan comandos de texto (incluido Sandbox).
TWILIO_SINGLE_CONTENT_SID=
TWILIO_BATCH_CONTENT_SID=

# Mongo, JWT y empresas se toman del backend existente (.env de la raíz).
REDIS_URL=redis://localhost:6379/0
STORAGE_PROVIDER=local
UPLOAD_DIR=data/captura
OCR_ENGINE=rapidocr
OCR_LANGUAGE=es
# Opcional: modelos locales previamente provisionados para despliegues sin red.
OCR_MODEL_PATH=
OCR_KEYS_PATH=
OCR_WORKER_CONCURRENCY=2
MAX_FILE_SIZE_MB=20
MAX_BATCH_DOCUMENTS=100
MAX_PDF_PAGES=30
FRONTEND_URL=http://localhost:5173
