# Git
.git
.gitignore

# Entornos virtuales
venv/
.venv/
env/

# Caché de Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.ruff_cache/
.pytest_cache/

# Archivos de entorno y secretos
.env
.env.local
# Credencial de la cuenta de servicio de Google (Vertex AI / Gemini).
# `*.json` ya la cubre en .gitignore; va explícita para que nadie la
# destape al tocar ese patrón.
service-account.json
*service-account*.json


# PDFs descargados: van en un volumen, no en la imagen
data/

# La imagen de la API solo copia app/, pero sin excluir esto se sube entero al
# contexto de build: frontend/node_modules son cientos de MB. El frontend tiene
# su propio Dockerfile, con su carpeta como contexto.
frontend/
logs/
tests/
docs/
scripts/
source/
