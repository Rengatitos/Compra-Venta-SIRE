# Mongo
MONGO_URI=mongodb://localhost:27017/?tls=false
MONGO_FACTURASDB_NAME=Mod_Facturas

# JWT
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=2

# Login con cuenta de Google (Google Identity Services corre en el navegador y
# el backend solo verifica el ID token que devuelve). CLIENT_ID es el del
# cliente OAuth de tipo "aplicacion web"; el origen del frontend tiene que
# estar en "Origenes de JavaScript autorizados" de ese cliente.
GOOGLE_CLIENT_ID=

# Administradores fijos del panel, separados por comas: entran siempre como
# admin y no se pueden quitar desde la web. Ellos dan acceso a los demas
# correos (rol admin o usuario) desde el panel: pantalla "Elige una empresa"
# o Ajustes > Cuentas con acceso. Sin fijos ni correos agregados no entra nadie.
GOOGLE_ALLOWED_EMAILS=

# Clave para cifrar las contraseñas SOL almacenadas en Mongo.
# Si no se define, se usa JWT_SECRET_KEY como semilla.
SOL_USER_CRYPTO_KEY=change-this-crypto-key

# Credenciales del cliente API de SUNAT (SIRE). Sirven de respaldo global
# cuando una empresa no tiene las suyas propias registradas.
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=

# Un endpoint por libro. Los dos devuelven JSON paginado con la misma forma
# ({paginacion, registros, totales}) y ambos exigen page y perPage; perPage
# tiene un techo de 100, por encima el SIRE responde 422. Ojo con el RCE: hay
# que apuntar a /busqueda, no a /comprobantes como en el RVIE.
URL_SIRE_PROPUESTA=https://api-sire.sunat.gob.pe/v1/contribuyente/migeigv/libros/rce/propuesta/web/propuesta/{PERIODO}/busqueda
URL_SIRE_PROPUESTA_VENTAS=https://api-sire.sunat.gob.pe/v1/contribuyente/migeigv/libros/rvie/propuesta/web/propuesta/{PERIODO}/comprobantes

# Paginacion de la propuesta. Antes page=1&perPage=100 iba incrustado en el
# codigo y cualquier periodo con mas de cien comprobantes se truncaba sin
# avisar. MAX_PAGINAS es el freno por si el endpoint ignora `page`.
SIRE_PER_PAGE=100
SIRE_MAX_PAGINAS=50

# Scraping del portal SOL para el detalle de items.
# HEADLESS=false abre el navegador visible, util para diagnosticar cambios
# del portal. TIMEOUT_MS es el techo de espera de cada paso de Playwright:
# subirlo multiplica el coste de cada comprobante que falla. MAX_COMPROBANTES
# limita cuantos se piden por extraccion; el resto queda para otra vuelta.
SUNAT_SCRAPER_HEADLESS=true
SUNAT_SCRAPER_TIMEOUT_MS=15000
SUNAT_MAX_COMPROBANTES=100
# Cuanto esperar la respuesta de una busqueda. Los comprobantes que el portal
# no tiene salen al instante por su propio aviso; este plazo solo lo agotan
# los emisores lentos (los bancos rondan los 9 s).
SUNAT_TIMEOUT_BUSQUEDA_MS=25000

# PDFs descargados del portal SOL. DATA_DIR es la raiz (relativa al repo si no
# es absoluta; en Docker debe ser un volumen), MAX_PDFS el tope por trabajo de
# descarga y PDF_TIMEOUT_MS el techo para capturar cada documento.
SUNAT_DATA_DIR=data
SUNAT_MAX_PDFS=100
SUNAT_PDF_TIMEOUT_MS=20000

# Origenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Integracion con sire-bot (Apaclla Bot). Misma cadena que SIRE_API_KEY en el
# .env del bot; generala larga y aleatoria. Vacia = los endpoints del bot
# responden 503.
SIRE_BOT_API_KEY=
# Carpeta de las fotos de los comprobantes que manda el bot.
COMPROBANTES_EXTERNOS_DIR=data/comprobantes-externos

# Clasificador contable (RAG + Gemini en Vertex AI). Apagado por defecto: al
# encenderlo la API carga torch y el modelo de embeddings (~1 GB de RAM mas) y
# la primera vez descarga el modelo e indexa el conocimiento en
# data/clasificador (en Docker, el volumen de /app/data).
CLASIFICADOR_HABILITADO=false
CLASIFICADOR_MAX_COMPROBANTES=200
# Antes de clasificar, consultar en la Consulta RUC de SUNAT el CIIU de las
# contrapartes que aun no estan en cache (unos segundos por RUC nuevo).
CLASIFICADOR_CONSULTAR_CONTRAPARTES=true
# Dias que una ficha RUC guardada se da por vigente antes de volver a consultarla.
FICHA_RUC_VIGENCIA_DIAS=90
# Credencial de una cuenta de servicio con acceso a Vertex AI. Nunca al
# repositorio (*.json ya esta en .gitignore). En Docker, montala como archivo.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
VERTEX_PROJECT=
VERTEX_LOCATION=global
# gemini-3.1-pro-preview: la mejor calidad (unos 10 s por llamada con busqueda).
# gemini-3.8-flash: casi tan buena y bastante mas rapida y barata.
GEMINI_MODEL=gemini-3.1-pro-preview
# Deja que Gemini consulte Google Search al interpretar el comprobante. La
# eleccion de la cuenta nunca busca: solo escoge entre candidatos del RAG.
GEMINI_BUSQUEDA_WEB=true
# Los modelos Pro razonan antes de responder y eso cuenta aqui.
GEMINI_MAX_OUTPUT_TOKENS=8192
# Umbral de confianza: por debajo, la clasificacion queda "requiere revision"
# y la cuenta base no pasa al Excel.
REVIEW_CONFIDENCE_THRESHOLD=0.60
# Hilos de CPU para los embeddings.
CPU_THREADS=2
# Resto de parametros finos (pesos del RAG, rutas, reintentos de Gemini):
# ver app/services/clasificador/config.py.
