# Token administrativo (header X-Admin-Token)
ADMIN_TOKEN=change-this-admin-token

# Mongo
MONGO_URI=mongodb://localhost:27017/?tls=false
MONGO_FACTURASDB_NAME=Mod_Facturas

# JWT
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=2

# Clave para cifrar las contraseñas SOL almacenadas en Mongo.
# Si no se define, se usa JWT_SECRET_KEY como semilla.
SOL_USER_CRYPTO_KEY=change-this-crypto-key

# Credenciales del cliente API de SUNAT (SIRE). Sirven de respaldo global
# cuando una empresa no tiene las suyas propias registradas.
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=

# Debe apuntar al endpoint de busqueda, no al de comprobantes.
URL_SIRE_PROPUESTA=https://api-sire.sunat.gob.pe/v1/contribuyente/migeigv/libros/rce/propuesta/web/propuesta/{PERIODO}/busqueda

# Scraping del portal SOL para el detalle de items.
# HEADLESS=false abre el navegador visible, util para diagnosticar cambios
# del portal. TIMEOUT_MS es el techo de espera de cada paso de Playwright:
# subirlo multiplica el coste de cada comprobante que falla. MAX_COMPROBANTES
# limita cuantos se piden por extraccion; el resto queda para otra vuelta.
SUNAT_SCRAPER_HEADLESS=true
SUNAT_SCRAPER_TIMEOUT_MS=15000
SUNAT_MAX_COMPROBANTES=100

# IA
GEMINI_API_KEY=

# Origenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
