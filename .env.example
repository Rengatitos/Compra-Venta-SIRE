# ==============================
# Automat - entorno local
# ==============================

# Modo de trabajo del backend.
# development: usa MONGO_URI_DEV
# production: usa MONGO_URI_PROD
ENVIRONMENT=development

# Host y puerto del backend FastAPI.
API_HOST=0.0.0.0
API_PORT=8000

# Token administrativo interno para endpoints protegidos del backend.
ADMIN_TOKEN=change-this-admin-token

# Mongo para entorno de desarrollo.
# Debe apuntar al cluster que contiene Mod_Facturas y CONTABILIDAD_CORE.
MONGO_URI_DEV=mongodb://localhost:27017/?tls=false

# Base donde viven sol_users, periodos y facturas.
MONGO_FACTURASDB_NAME=Mod_Facturas

# Base maestra de contabilidad.
MONGO_CONTDB_NAME=CONTABILIDAD_CORE

# Mongo para entorno de produccion.
MONGO_URI_PROD=mongodb://localhost:27017/?tls=false
MONGO_DB_NAME_PROD=automat_sunat_prod

# JWT propio del backend Automat.
# No confundir con el token principal de AUTH-API.
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=2

# API key de Gemini para embeddings y generacion.
GEMINI_API_KEY=

# Modo recomendado para cuentas free.
# free: procesa por tandas con espera
# normal: procesa sin la ventana protectora
GEMINI_REQUEST_MODE=free

# Tamano maximo de cada tanda cuando GEMINI_REQUEST_MODE=free.
GEMINI_FREE_BATCH_SIZE=5

# Espera entre tandas en segundos cuando GEMINI_REQUEST_MODE=free.
GEMINI_FREE_WAIT_SECONDS=55

# Endpoint SIRE funcional actualmente en prueba2.
# Mantener /busqueda; /comprobantes devolvia error en este flujo.
URL_SIRE_PROPUESTA=https://api-sire.sunat.gob.pe/v1/contribuyente/migeigv/libros/rce/propuesta/web/propuesta/{PERIODO}/busqueda
